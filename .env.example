# Sweat With Wilk — copy to ".env" locally, or set these in your host's dashboard.
# Port the server listens on (most hosts set this automatically).
PORT=3000
# Where the SQLite database file lives (local fallback only). Default: ./data/app.db
DB_PATH=./data/app.db
# Hosted database (Turso/libSQL). When TURSO_DATABASE_URL is set, ALL app data
# (accounts, tickets, board) lives in the hosted database and survives restarts
# and redeploys; DB_PATH is ignored. Set both in the host's dashboard.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Secret token the morning board/ticket jobs must send in the x-push-token header.
# Make it long and random, and keep it private.
PUSH_TOKEN=change-me-to-a-long-random-string
# Web Push (lock-screen alerts). Generate a pair once with:
#   npx web-push generate-vapid-keys
# Public key is handed to browsers; private key stays secret on the host.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bosscochon1804@gmail.com
